# --- Open WebUI Configuration ---
WEBUI_PORT=3080
WEBUI_SECRET_KEY=generate_with_openssl_rand_hex_32
WEBUI_ADMIN_EMAIL=admin@internal.local
WEBUI_ADMIN_PASSWORD=change_this_master_password

# --- LiteLLM Proxy & Auth ---
LITELLM_MASTER_KEY=sk-proxy_master_key_generate_with_openssl_hex_32
LITELLM_SALT_KEY=generate_with_openssl_rand_hex_16

# --- Database Backend (Postgres 16) ---
POSTGRES_DB=litellm
POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=generate_a_secure_password

# --- SearXNG Privacy Search ---
SEARXNG_PORT=3090
SEARXNG_SECRET=generate_with_openssl_rand_hex_32

# --- Distributed Tailscale Node ---
# Replace with the Tailscale IPv4 address of the Apple Silicon inference node
OLLAMA_NODE_IP=100.x.x.x

# --- Cloud Fallback (Gemini Enterprise Agent Platform) ---
GCP_PROJECT_ID=your-gcp-project-id